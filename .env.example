# ─── MADiE Local Environment Configuration ───────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Frontend Ports ───────────────────────────────────────────────────────────
MADIE_ROOT_PORT=9000
MADIE_LAYOUT_PORT=8500
MADIE_AUTH_PORT=8502
MADIE_EDITOR_PORT=8501
MADIE_MEASURE_PORT=8505
MADIE_CQL_LIBRARY_PORT=8507
MADIE_UTIL_PORT=8508

# ─── Java Microservice Ports ─────────────────────────────────────────────────
MEASURE_SERVICE_PORT=8080
MADIE_FHIR_SERVICE_PORT=8085
TERMINOLOGY_SERVICE_PORT=8081
CQL_LIBRARY_SERVICE_PORT=8082
MADIE_QDM_SERVICE_PORT=8086
MADIE_USER_SERVICE_PORT=8088
MADIE_FHIR_ELM_TRANSLATOR_PORT=8083
MADIE_QDM_ELM_TRANSLATION_PORT=8084

# ─── Node / Ruby Service Ports ───────────────────────────────────────────────
VIRUS_SCAN_SERVICE_PORT=5000
QRDA_EXPORT_SERVICE_PORT=8089
EXCEL_EXPORT_PORT=3000

# ─── Standalone Ports ────────────────────────────────────────────────────────
SUPPORT_DATA_PORT=8660

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=E5press0
MONGO_DB_NAME=madie
MONGO_OPTIONS=?authSource=admin&maxPoolSize=50&connectTimeoutMS=2000&serverSelectionTimeoutMS=2000

# ─── Okta (external IdP) ─────────────────────────────────────────────────────
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
OKTA_CLIENT_ID=your-client-id

# ─── VSAC ─────────────────────────────────────────────────────────────────────
VSAC_API_KEY=your-vsac-api-key

# ─── HARP (user-service) ─────────────────────────────────────────────────────
HARP_CLIENT_ID=your-harp-client-id
HARP_LOCAL_OVERRIDE_ID=
HARP_SECRET=your-harp-secret

# ─── Feature Flags ───────────────────────────────────────────────────────────
FORCE_VIRUS_SCAN=true

# ─── Java Options (shared across all Maven services) ─────────────────────────
MAVEN_OPTS=-Xmx512m
